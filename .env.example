# ==============================================================
# GaBookAutoDownloader - Variables de Entorno de Ejemplo
# ==============================================================

# Token del Bot de Telegram (obtenido de @BotFather)
TELEGRAM_BOT_TOKEN="tu_token_de_telegram_aqui"

# Credenciales de Gmail (con contraseña de aplicación de 16 letras)
GMAIL_USER="tu_correo@gmail.com"
GMAIL_APP_PASSWORD="tu_contrasena_de_aplicacion_google"

# Correo Kindle predeterminado
KINDLE_EMAIL="tu_kindle@kindle.com"

# Perfiles familiares opcionales (para los botones táctiles en Telegram)
KINDLE_LABEL_PAPA="👨‍🦳 Kindle de Papá"
KINDLE_EMAIL_PAPA="familiar1@kindle.com"

KINDLE_LABEL_GONZALO="👦 Kindle de Gonzalo"
KINDLE_EMAIL_GONZALO="familiar2@kindle.com"

KINDLE_LABEL_GABRIEL="👤 Mi Kindle"
KINDLE_EMAIL_GABRIEL="tu_kindle@kindle.com"
